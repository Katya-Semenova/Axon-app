# ─────────────────────────────────────────────────────────────────────────────
# AXON — шаблон переменных окружения (БЕЗ реальных секретов).
#
# Это образец: показывает, КАКИЕ переменные нужны приложению. Реальные значения
# живут ТОЛЬКО в файлах, которых нет в git:
#   • локально (для разработки) — .env.local
#   • на сервере (прод)         — .env.production   (права 600, вне git)
# Резервная копия секретов — в Bitwarden (НЕ в iCloud, НЕ в git).
#
# Копируешь этот файл в .env.local / .env.production и вписываешь значения.
# ─────────────────────────────────────────────────────────────────────────────

# ── База данных (Урок 4, Шаг 1) ──────────────────────────────────────────────
# Логин и имя базы (можно оставить как есть). ПАРОЛЬ — сгенерируем, сюда не пишем.
POSTGRES_USER=axon
POSTGRES_PASSWORD=
POSTGRES_DB=axon

# Строка, по которой приложение находит базу.
# host = "db" — это имя сервиса базы в docker-compose (общая внутренняя сеть).
# PASSWORD замени на реальный пароль из POSTGRES_PASSWORD.
DATABASE_URL=postgresql://axon:PASSWORD@db:5432/axon

# ── Авторизация (Урок 4, Шаг 5, Better Auth) ─────────────────────────────────
# Секрет для подписи сессий. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Публичный адрес сервиса — С приставкой /ai-studio (топология, ADR-010): сервис живёт на
# подстранице. Better Auth по нему строит адрес API входа и ссылки в письмах сброса пароля.
# Прод: https://axon-app.ru/ai-studio ; локально: http://localhost:3000/ai-studio
BETTER_AUTH_URL=https://axon-app.ru/ai-studio

# ── Письма аккаунта (Урок 4, Шаг 6, Resend) ──────────────────────────────────
# Ключ для отправки писем (сброс пароля, welcome). Создать: resend.com → API Keys.
# Это СЕКРЕТ — вписывается ТОЛЬКО в .env (локально, опционально) и в .env.production
# на сервере (обязательно для реальной отправки). В git не попадает. Резерв — Bitwarden.
# Локально письма не шлём (тестируем на проде), превью шаблонов — npm run email:dev (ключ не нужен).
RESEND_API_KEY=

# ── Хранилище файлов (Урок 4, Шаг 8, Selectel Object Storage / S3) ────────────
# Куда складываем загруженные файлы (аватары и т.д.). Сам файл — в хранилище,
# в базе — только ссылка. Создать bucket + ключи: панель Selectel → Object Storage.
# Это СЕКРЕТЫ (access/secret key) — вписываются ТОЛЬКО в .env.production на сервере;
# в git не попадают, резерв — Bitwarden. Endpoint/регион/бакет/публичный URL — из панели.
S3_ENDPOINT=
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# (Не используется в текущем режиме: файлы отдаём через свой route /api/files.
#  Оставлено на будущее, если перейдём на прямой публичный домен провайдера.)
S3_PUBLIC_URL=

# ── ИИ-извлечение инсайтов (Урок 5, Шаг 1; см. docs/decisions/ADR-008-ai-provider.md) ──
# Провайдер-агностичный слой lib/ai/: смена провайдера = смена этих переменных, не кода.
# Ключи — СЕКРЕТЫ, вписываются ТОЛЬКО в .env.local (dev) / .env.production (прод), не в git.
# Без ключа ИИ-разбор недоступен → приложение тихо падает на разбор по правилам (fallback).
#
# Какой провайдер: openrouter (дефолт, доступ к Claude/GPT) | gigachat (опция для РФ-прода).
AI_PROVIDER=openrouter
# Модель у провайдера (для OpenRouter — точный slug). Пусто → дефолт из lib/ai/index.ts.
AI_MODEL=anthropic/claude-sonnet-4.6
# Таймаут запроса к ИИ, мс (дефолт 30000).
AI_TIMEOUT_MS=30000
# Rate-limit на пользователя: запросов (AI_RATE_MAX) в окне (AI_RATE_WINDOW, сек).
AI_RATE_MAX=10
AI_RATE_WINDOW=60
# Ключ OpenRouter (openrouter.ai → Keys). Нужен при AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Ключ GigaChat (developers.sber.ru). Нужен при AI_PROVIDER=gigachat (адаптер — заготовка).
GIGACHAT_API_KEY=

# ── Аналитика (Урок 6, Задание 3.1, Яндекс.Метрика) ──────────────────────────
# ID счётчика — НЕ секрет (встраивается в публичный HTML), но держим в env, чтобы
# не хардкодить. Тот же ID, что на лендинге (один домен в проде) — нужен для цели
# signup_complete. Счётчик грузится только после согласия (cookie-баннер).
NEXT_PUBLIC_YM_ID=110037189
