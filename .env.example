# ─────────────────────────────────────────────────────────────────────────────
# AXON — шаблон переменных окружения (БЕЗ реальных секретов).
#
# Это образец: показывает, КАКИЕ переменные нужны приложению. Реальные значения
# живут ТОЛЬКО в файлах, которых нет в git:
#   • локально (для разработки) — .env.local
#   • на сервере (прод)         — .env.production   (права 600, вне git)
# Резервная копия секретов — в Bitwarden (НЕ в iCloud, НЕ в git).
#
# Копируешь этот файл в .env.local / .env.production и вписываешь значения.
# ─────────────────────────────────────────────────────────────────────────────

# ── База данных (Урок 4, Шаг 1) ──────────────────────────────────────────────
# Логин и имя базы (можно оставить как есть). ПАРОЛЬ — сгенерируем, сюда не пишем.
POSTGRES_USER=axon
POSTGRES_PASSWORD=
POSTGRES_DB=axon

# Строка, по которой приложение находит базу.
# host = "db" — это имя сервиса базы в docker-compose (общая внутренняя сеть).
# PASSWORD замени на реальный пароль из POSTGRES_PASSWORD.
DATABASE_URL=postgresql://axon:PASSWORD@db:5432/axon
